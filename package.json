{
  "name": "electro-cat",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.electrocat.app",
    "productName": "ElectroCat",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "files": [
      "**/*",
      "!dist/*",
      "!*.log",
      "!data/**",
      "!manifest.json",
      "!make-manifest.js"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "ElectroCat-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pxtk08",
        "repo": "Electro-Cat-App"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
